# Copia este archivo como .env y rellena los valores (nunca subas .env a GitHub)
# Supabase → botón Connect → Session pooler (contraseña de la BD, solo letras y números)
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Supabase → Project Settings → API Keys (Publishable key, sb_publishable_...)
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_KEY=
